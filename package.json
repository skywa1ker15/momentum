{
  "name": "momentum",
  "private": true,
  "version": "0.8.0",
  "description": "MOMENTUM - advanced 3D physics sandbox (Babylon.js + Havok)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint",
    "e2e": "node e2e/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@babylonjs/core": "^9.37.2",
    "@babylonjs/havok": "^1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^26.6.10",
    "puppeteer-core": "^25.19.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
